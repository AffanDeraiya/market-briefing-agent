# Copy to backend/.env and fill in a key. All dev + the public demo run on free tiers.

# LLM provider: gemini | groq | openrouter   (all OpenAI-compatible)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-key-here    # free at aistudio.google.com (default provider)
GROQ_API_KEY=                          # only if LLM_PROVIDER=groq
OPENROUTER_API_KEY=                    # only if LLM_PROVIDER=openrouter (used for cassettes)

# Search provider: ddgs | tavily
SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=                        # only if SEARCH_PROVIDER=tavily

# Agent budgets (per run)
MAX_TOOL_CALLS=15
MAX_ITERATIONS=20
MAX_OUTPUT_TOKENS=4096

# Rate limits
RATE_LIMIT_BRIEFS_PER_HOUR=5
RATE_LIMIT_BRIEFS_PER_DAY=20
RATE_LIMIT_VALIDATE_PER_HOUR=30
RATE_LIMIT_SEARCH_PER_MINUTE=60
GLOBAL_DAILY_BRIEFS=100

# Concurrency caps (in-flight briefs)
MAX_CONCURRENT_GLOBAL=6
MAX_CONCURRENT_PER_IP=2

# yfinance disk cache
MAX_CACHE_FILES=200
# MBA_CACHE_DIR=                       # optional; defaults to backend/.cache

CORS_ORIGINS=http://localhost:5173
